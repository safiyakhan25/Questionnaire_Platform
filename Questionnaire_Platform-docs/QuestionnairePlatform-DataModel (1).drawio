        <mxCell id="2_rsp_NJHVGg7MUJCY-c-419" parent="2_rsp_NJHVGg7MUJCY-c-416" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="Timestamp" vertex="1">
