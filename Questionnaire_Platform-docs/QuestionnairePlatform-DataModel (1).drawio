        <mxCell id="2_rsp_NJHVGg7MUJCY-c-421" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;strong data-start=&quot;6340&quot; data-end=&quot;6356&quot;&gt;Design Note:&lt;/strong&gt; Responses are persisted in both &lt;code data-start=&quot;6389&quot; data-end=&quot;6408&quot;&gt;QUESTION_RESPONSE&lt;/code&gt; and the corresponding business entity (&lt;code data-start=&quot;6448&quot; data-end=&quot;6456&quot;&gt;PERSON&lt;/code&gt;, &lt;code data-start=&quot;6458&quot; data-end=&quot;6473&quot;&gt;FAMILY_MEMBER&lt;/code&gt;, &lt;code data-start=&quot;6475&quot; data-end=&quot;6484&quot;&gt;DISEASE&lt;/code&gt;, or &lt;code data-start=&quot;6489&quot; data-end=&quot;6499&quot;&gt;MUTATION&lt;/code&gt;) using &lt;code data-start=&quot;6507&quot; data-end=&quot;6519&quot;&gt;answer_key&lt;/code&gt;. &lt;code data-start=&quot;6521&quot; data-end=&quot;6540&quot;&gt;QUESTION_RESPONSE&lt;/code&gt; provides audit history and Save &amp;amp; Resume, while business entities maintain the latest state used for rule evaluation." vertex="1">
          <mxGeometry height="172" width="219" x="4382" y="2214" as="geometry" />
        </mxCell>
        <mxCell id="2_rsp_NJHVGg7MUJCY-c-422" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;QUESTIONNAIRE PLATFORM DATA MODEL&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="533" x="3263.5" y="1038" as="geometry" />
        </mxCell>
        <mxCell id="2_rsp_NJHVGg7MUJCY-c-423" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=12;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;strong data-start=&quot;2197&quot; data-end=&quot;2213&quot;&gt;Design Change (from HLD):&lt;/strong&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;&lt;code data-start=&quot;2214&quot; data-end=&quot;2231&quot; style=&quot;&quot;&gt;gender_identity&lt;/code&gt; &lt;/b&gt;and &lt;b&gt;&lt;code data-start=&quot;2236&quot; data-end=&quot;2248&quot;&gt;blood_type&lt;/code&gt; &lt;/b&gt;are stored as direct values instead of foreign keys because these values are collected through questionnaire responses. Allowed values are controlled by the questionnaire configuration (&lt;code data-start=&quot;2428&quot; data-end=&quot;2445&quot;&gt;QUESTION_OPTION&lt;/code&gt;) rather than separate lookup tables." vertex="1">
          <mxGeometry height="158" width="212" x="2924" y="2177" as="geometry" />
        </mxCell>
        <mxCell id="2_rsp_NJHVGg7MUJCY-c-424" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;spacingLeft=8;fontColor=light-dark(#050505, #c1c1c1);" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Appendix: ENUM Definitions&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. &lt;u&gt;QUESTION.type&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;TEXT&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;NUMBER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;DATE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;RADIO&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;CHECKBOX&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;DROPDOWN&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. &lt;u&gt;QUESTIONNAIRE_SESSION.status&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;i&gt;IN_PROGRESS&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;COMPLETED&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. &lt;u&gt;FAMILY_MEMBER.relationship_type&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;MOTHER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;FATHER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;BROTHER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;SISTER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;SON&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;DAUGHTER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;SPOUSE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;HALF_BROTHER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;HALF_SISTER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;ADOPTED_SON&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;ADOPTED_DAUGHTER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;GRANDFATHER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;GRANDMOTHER&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;UNCLE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;AUNT&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;COUSIN&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;NIECE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;NEPHEW&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. &lt;u&gt;FAMILY_MEMBER.maternal_paternal_side&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;i&gt;MATERNAL&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;PATERNAL&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;UNKNOWN&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;5. &lt;u&gt;PERSON.gender_at_birth&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;MALE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;FEMALE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;INTERSEX&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;UNKNOWN&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;6. &lt;u&gt;FAMILY_MEMBER.gender_at_birth&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;MALE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;FEMALE&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;INTERSEX&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;UNKNOWN&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;7. &lt;u&gt;QUESTION_RESPONSE.answer_type&lt;/u&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;BOOLEAN&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;NUMBER&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;STRING&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;ARRAY&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;OBJECT&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="835" width="270" x="4382" y="1243" as="geometry" />
        </mxCell>
